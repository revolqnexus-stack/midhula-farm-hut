{{ 'lifecycle.css' | asset_url | stylesheet_tag }}

<section class="lifecycle-section section" id="lifecycle">
  <div class="container">
    <div class="lifecycle-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="lifecycle-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="lifecycle-timeline">
      {% for block in section.blocks %}
        <div class="lifecycle-stage" data-stage="{{ forloop.index }}">
          <div class="stage-image">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                 loading: 'lazy',
                 alt: block.settings.label
              }}
            {%- else -%}
              <div class="stage-image-placeholder"></div>
            {%- endif -%}
          </div>
          
          <div class="stage-content">
            <div class="stage-number">{{ forloop.index }}</div>
            <h3 class="stage-label">{{ block.settings.label }}</h3>
            <p class="stage-description">{{ block.settings.description }}</p>
          </div>

          {% unless forloop.last %}
            <div class="stage-connector" aria-hidden="true"></div>
          {% endunless %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifecycle Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "From tiny beginnings to beautiful little swimmers"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Lifecycle Stage",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Stage Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stage Label",
          "default": "Stage"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Stage Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifecycle Story",
      "blocks": [
        {
          "type": "stage",
          "settings": {
            "label": "Egg",
            "description": "Life begins"
          }
        },
        {
          "type": "stage",
          "settings": {
            "label": "Fry",
            "description": "First swim"
          }
        },
        {
          "type": "stage",
          "settings": {
            "label": "Juvenile",
            "description": "Growing strong"
          }
        },
        {
          "type": "stage",
          "settings": {
            "label": "Adult",
            "description": "Ready for a new home"
          }
        }
      ]
    }
  ]
}
{% endschema %}
