<section class="featured-collections section">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="collections-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% if collection %}
          <a href="{{ collection.url }}" class="collection-card">
            <div class="collection-image">
              {% if collection.featured_image %}
                {{ collection.featured_image | image_url: width: 800 | image_tag:
                   loading: 'lazy',
                   alt: collection.title
                }}
              {% else %}
                <div class="collection-placeholder"></div>
              {% endif %}
            </div>
            <div class="collection-content">
              <h3 class="collection-title">{{ collection.title }}</h3>
              <p class="collection-count">{{ collection.products_count }} species</p>
              <span class="collection-cta">Explore →</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .featured-collections {
    background: var(--color-white);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  
  .section-heading {
    font-size: var(--text-5xl);
    color: var(--color-deep-water);
  }
  
  .collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  
  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .collection-card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-white);
    box-shadow: var(--shadow-base);
    transition: all var(--duration-base) var(--ease-out);
  }
  
  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .collection-image {
    aspect-ratio: 1;
    overflow: hidden;
  }
  
  .collection-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  
  .collection-card:hover .collection-image img {
    transform: scale(1.05);
  }
  
  .collection-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-water-light), var(--color-leaf-light));
  }
  
  .collection-content {
    padding: var(--space-6);
  }
  
  .collection-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-deep-water);
    margin-bottom: var(--space-2);
  }
  
  .collection-count {
    font-size: var(--text-base);
    color: var(--color-ink-light);
    margin-bottom: var(--space-3);
  }
  
  .collection-cta {
    display: inline-block;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-coral);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  
  .collection-card:hover .collection-cta {
    transform: translateX(4px);
  }
  
  @media (max-width: 768px) {
    .section-heading {
      font-size: var(--text-3xl);
    }
  }
</style>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Meet the little stars"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections"
    }
  ]
}
{% endschema %}
