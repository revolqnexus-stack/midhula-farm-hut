{{ 'header.css' | asset_url | stylesheet_tag }}

<header class="site-header" id="header">
  <div class="header-container">
    <div class="header-logo">
      {%- if settings.logo != blank -%}
        <a href="/" class="logo-link">
          {{ settings.logo | image_url: width: settings.logo_width | image_tag: 
             loading: 'lazy',
             alt: shop.name
          }}
        </a>
      {%- else -%}
        <a href="/" class="logo-text">
          <span class="brand-name">{{ shop.name }}</span>
        </a>
      {%- endif -%}
    </div>

    <nav class="header-nav desktop-only" role="navigation">
      <ul class="nav-list">
        <li><a href="/#farm" class="nav-link">Our Farm</a></li>
        <li><a href="/collections/all" class="nav-link">The Fish</a></li>
        <li><a href="/#dispatch" class="nav-link">Dispatch</a></li>
        <li><a href="/pages/contact" class="nav-link">Contact</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/collections/all" class="btn btn-primary btn-shop">Shop Fish</a>
      <a href="/cart" class="cart-link">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
      </a>
      <button class="mobile-menu-toggle mobile-only" aria-label="Open menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-content">
      <button class="mobile-menu-close" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <nav class="mobile-nav" role="navigation">
        <ul class="mobile-nav-list">
          <li><a href="/" class="mobile-nav-link">Home</a></li>
          <li><a href="/#farm" class="mobile-nav-link">Our Farm</a></li>
          <li><a href="/collections/all" class="mobile-nav-link">The Fish</a></li>
          <li><a href="/#dispatch" class="mobile-nav-link">Dispatch</a></li>
          <li><a href="/pages/contact" class="mobile-nav-link">Contact</a></li>
        </ul>
        <div class="mobile-menu-cta">
          <a href="/collections/all" class="btn btn-primary btn-large">Shop Fish</a>
        </div>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header",
      "default": true
    }
  ]
}
{% endschema %}
