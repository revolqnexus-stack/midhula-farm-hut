<section class="final-cta section">
  <div class="container">
    <div class="cta-content">
      {%- if section.settings.heading != blank -%}
        <h2 class="cta-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      <div class="cta-buttons">
        <a href="{{ section.settings.button_link }}" class="btn btn-primary btn-large">
          {{ section.settings.button_label }}
        </a>
        
        {%- if settings.whatsapp_number != blank -%}
          <a href="https://wa.me/{{ settings.whatsapp_number }}" 
             target="_blank"
             rel="noopener noreferrer"
             class="btn btn-secondary btn-large">
            Chat on WhatsApp
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: linear-gradient(135deg, var(--color-deep-water), var(--color-water));
    color: var(--color-white);
  }
  
  .cta-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .cta-heading {
    font-size: var(--text-6xl);
    color: var(--color-white);
    margin-bottom: var(--space-10);
  }
  
  .cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  
  @media (max-width: 768px) {
    .cta-heading {
      font-size: var(--text-4xl);
    }
    
    .cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    
    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to bring home a little colour?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Final CTA"
    }
  ]
}
{% endschema %}
